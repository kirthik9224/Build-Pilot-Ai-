# Organization: Orbytes Global Solutions, Owner: Logaraj S, Created at: 2026-10-11
# Description: Environment variable template for BuildPilot AI Pro

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/buildpilot?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=NewPassword@123

# Spring Security & JWT Secret
BUILDPILOT_JWT_SECRET=BuildPilotSecretKeyForJwtAuthenticationProduction2026SecureKey!

# AI LLM Provider Configuration (Optional: Gemini, OpenAI, or Local Deterministic)
BUILDPILOT_AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
BUILDPILOT_AI_MODEL=gemini-1.5-flash
